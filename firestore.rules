rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Receipt verification is public so QR codes scanned by anyone/members can verify receipt authenticity
    match /receipts/{receiptId} {
      allow read: if true;
      allow write: if request.auth != null || true; // allow recording receipts
    }

    // Committee settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }

    // Members collection
    match /members/{memberId} {
      allow read, write: if true;
    }

    // Installments collection
    match /installments/{installmentId} {
      allow read, write: if true;
    }

    // Payments collection
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // Refunds collection
    match /refunds/{refundId} {
      allow read, write: if true;
    }

    // Audit logs
    match /auditLogs/{logId} {
      allow read, create: if true;
      allow update, delete: if false; // immutable logs
    }
  }
}
